# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# --- OpenAI (voice loop) ---
# Paid, pay-as-you-go key from https://platform.openai.com (NOT ChatGPT Plus).
OPENAI_API_KEY=sk-...

# Realtime model. Default is the GA model. If your account 404s on it,
# fall back to: gpt-4o-realtime-preview
OPENAI_REALTIME_MODEL=gpt-realtime

# Voice. Safe default is "alloy". Newer, more natural options on gpt-realtime
# include "cedar" and "marin". Others: ash, ballad, coral, echo, sage, shimmer, verse.
OPENAI_REALTIME_VOICE=alloy

# --- Anthropic (scorecard — used from Phase 1) ---
# Paid key from https://console.anthropic.com (NOT your Claude Pro/Max plan).
ANTHROPIC_API_KEY=sk-ant-...

# --- Server ---
PORT=3000
